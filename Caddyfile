# Two separate site blocks (not one combined 2-SAN block) to avoid certificate
# coupling between the Route 53 domain and the sslip.io fallback.

# Real visitor IP: trust is opt-in. Default trusts only loopback, so a direct publish (EC2)
# ignores a forged CF-Connecting-IP and uses the real remote address. Tunnel mode sets
# TRUSTED_PROXY_RANGES=172.16.0.0/12 (cloudflared -> caddy over docker; the Cloudflare edge
# sets CF-Connecting-IP and rejects client-supplied values).
{
	servers {
		trusted_proxies static {$TRUSTED_PROXY_RANGES:127.0.0.1/32}
		client_ip_headers CF-Connecting-IP
	}
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}

# Shared by all site blocks: security headers, API body limit, API proxy.
# The API reads the FIRST X-Forwarded-For value, so it is replaced (not appended) with {client_ip}.
(hardening) {
	import security_headers
	request_body /api/* {
		max_size 64KB
	}
	reverse_proxy /api/* api:8000 {
		header_up X-Forwarded-For {client_ip}
	}
	# Error responses (e.g. 413) bypass the header handler above; apply the same headers there.
	handle_errors {
		import security_headers
	}
}

# Staging CA (최초 발급 시 이 블록 사용 — 발급 성공 후 운영 CA로 전환):
# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
{$DOMAIN} {
	tls {$ACME_EMAIL}
	encode gzip
	root * /srv/web
	try_files {path} {path}.html {path}/
	file_server
	import hardening
}

# Staging CA (최초 발급 시 이 블록 사용 — 발급 성공 후 운영 CA로 전환):
# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
{$FALLBACK_DOMAIN} {
	tls {$ACME_EMAIL}
	encode gzip
	root * /srv/web
	try_files {path} {path}.html {path}/
	file_server
	import hardening
}

# Local development (make up + curl localhost/api/health). No TLS, no static-export deep-link fix.
:80 {
	root * /srv/web
	try_files {path} {path}.html {path}/
	file_server
	import hardening
}
